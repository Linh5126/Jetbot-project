# On-board person following at boot (no PC, no WiFi). Install on the Nano:
#   sudo cp ~/jetbot_follow/onboard/jetbot-follow.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jetbot-follow
# Logs: journalctl -u jetbot-follow -f   (CSV: ~/jetbot_follow/logs/)
# Stop (sends /stop to the motors): sudo systemctl stop jetbot-follow
[Unit]
Description=JetBot on-board person following (TensorRT)
After=jetbot-agent.service
Wants=jetbot-agent.service

[Service]
Type=simple
User=jetbot
WorkingDirectory=/home/jetbot/jetbot_follow
Environment=PYTHONUNBUFFERED=1
# onboard.run retries the agent for 120 s (its container starts late after boot).
ExecStart=/usr/bin/python3 -m onboard.run
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
